---
interface Props {
  quote:   string
  name:    string
  role?:   string
  company?: string
  initials: string
  rating?: number
}

const { quote, name, role, company, initials, rating = 5 } = Astro.props
---

<div class="t-card">
  <div class="t-stars" aria-label={`${rating} out of 5 stars`}>
    {Array.from({ length: rating }).map(() => (
      <span aria-hidden="true">★</span>
    ))}
  </div>
  <blockquote class="t-quote">"{quote}"</blockquote>
  <div class="t-author">
    <div class="t-avatar" aria-hidden="true">{initials}</div>
    <div class="t-info">
      <strong>{name}</strong>
      {(role || company) && (
        <span>{[role, company].filter(Boolean).join(', ')}</span>
      )}
    </div>
  </div>
</div>

<style>
  .t-card {
    background: var(--navy);
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    height: 100%;
  }
  .t-card:hover {
    border-color: var(--border);
    box-shadow: 0 0 60px var(--signal-trace);
    transform: translateY(-3px);
  }

  .t-stars {
    display: flex;
    gap: 2px;
    color: var(--signal);
    font-size: 14px;
  }

  .t-quote {
    font-family: var(--font-body);
    font-size: clamp(14px, 1vw, 16px);
    color: var(--ink-muted);
    line-height: 1.75;
    font-style: normal;
    flex: 1;
  }

  .t-author {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
  }

  .t-avatar {
    width: 42px; height: 42px;
    background: linear-gradient(135deg, var(--signal), var(--signal-dim));
    color: var(--ink-inverse);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 16px;
    flex-shrink: 0;
  }

  .t-info { display: flex; flex-direction: column; gap: 2px; }
  .t-info strong {
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .t-info span {
    font-size: 12px;
    color: var(--ink-faint);
    font-family: var(--font-ui);
  }
</style>
