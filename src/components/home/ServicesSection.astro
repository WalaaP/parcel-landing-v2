---
import ServiceCards3D from '../react/ServiceCards3D.tsx'
import { services as localServices } from '../../data/services'

interface SanityService {
  id: string
  tier: string
  badge: string
  tagline?: string
  image?: string
  accentColor: string
  features?: string[]
}

interface Props {
  servicesSection?: {
    tag?: string
    title?: string
    titleEm?: string
    sub?: string
  }
  services?: SanityService[]
}

const { servicesSection, services: sanityServices } = Astro.props

const tag     = servicesSection?.tag     ?? 'Choose Your Speed'
const title   = servicesSection?.title   ?? 'THREE TIERS.'
const titleEm = servicesSection?.titleEm ?? 'ONE STANDARD.'
const sub     = servicesSection?.sub     ?? 'Instant urgency or next-day planning — every delivery runs on the same real-time intelligence engine, built and operated from Manama.'

const isAr     = Astro.currentLocale === 'ar'
const prefix   = isAr ? '/ar' : ''
const learnMore = isAr ? 'اطّلع على المزيد ←' : 'Learn More →'

function hexToRgba(hex: string, alpha: number) {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)
  return `rgba(${r}, ${g}, ${b}, ${alpha})`
}

const services = sanityServices?.length
  ? sanityServices.map(s => ({
      id:          s.id,
      tier:        s.tier,
      badge:       s.badge,
      tagline:     s.tagline  ?? '',
      image:       s.image    ?? '',
      accentColor: s.accentColor,
      glowColor:   hexToRgba(s.accentColor, 0.25),
      gradient:    'linear-gradient(170deg, rgba(6,15,24,0.2) 0%, rgba(6,15,24,0.98) 75%)',
      features:    s.features ?? [],
      href:        `${prefix}/services#${s.id}`,
    }))
  : localServices
---

<section class="services-section section--dark">
  <div class="services-header container" style="max-width: var(--max-width); margin: 0 auto; padding: var(--section-y) var(--section-x) 60px;">
    <span class="tag" data-reveal>{tag}</span>
    <h2 class="section-title" data-reveal data-reveal-delay="80">
      {title}<br/><em>{titleEm}</em>
    </h2>
    <p class="section-sub" data-reveal data-reveal-delay="160">{sub}</p>
  </div>

  <ServiceCards3D services={services} learnMore={learnMore} client:visible />
</section>
