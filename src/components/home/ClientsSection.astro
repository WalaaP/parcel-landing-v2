---
import { clients as localClients, type Client } from '../../data/clients'
import { testimonials as localTestimonials, type Testimonial } from '../../data/testimonials'
import TestimonialCard from '../shared/TestimonialCard.astro'

interface Props {
  clients?:      Client[]
  testimonials?: Testimonial[]
  clientsSection?: {
    tag?: string
    title?: string
    titleEm?: string
    testimonialsTitle?: string
  }
}

const {
  clients         = localClients,
  testimonials    = localTestimonials,
  clientsSection,
} = Astro.props

const tag               = clientsSection?.tag               ?? 'Trusted by 500+ Businesses'
const title             = clientsSection?.title             ?? 'WHO SHIPS'
const titleEm           = clientsSection?.titleEm           ?? 'WITH PARCEL.'
const testimonialsTitle = clientsSection?.testimonialsTitle ?? 'What our clients say'
---

<section class="section section--dark clients-section">
  <div class="clients-inner container">

    <div class="clients-header">
      <span class="tag" data-reveal>{tag}</span>
      <h2 class="section-title" data-reveal data-reveal-delay="80">
        {title}<br/><em>{titleEm}</em>
      </h2>
    </div>

    <!-- Client logo grid -->
    <div class="client-grid" role="list" aria-label="Our clients">
      {clients.map((client, i) => (
        <div class="client-item" role="listitem" data-reveal="scale" data-reveal-delay={String(i * 50)}>
          <div class="client-avatar" style={`background: ${client.color}22; border: 1px solid ${client.color}33;`}>
            <span style={`color: ${client.color}`}>{client.initials}</span>
          </div>
          <div class="client-info">
            <strong>{client.name}</strong>
            <span>{client.industry}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Testimonials -->
    <div class="testimonials-header" data-reveal>
      <h3>{testimonialsTitle}</h3>
    </div>
    <div class="testimonials-grid">
      {testimonials.map((t, i) => (
        <div data-reveal="scale" data-reveal-delay={String(i * 80)}>
          <TestimonialCard
            quote={t.quote}
            name={t.name}
            role={t.role}
            company={t.company}
            initials={t.initials}
            rating={t.rating}
          />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .clients-section { padding: var(--section-y) var(--section-x); }

  .clients-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .clients-header {
    margin-bottom: 56px;
  }

  .client-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 80px;
  }

  .client-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--navy);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 14px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .client-item:hover {
    border-color: var(--border);
    transform: translateY(-2px);
  }

  .client-avatar {
    width: 36px; height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .client-avatar span {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
  }

  .client-info { min-width: 0; }
  .client-info strong {
    display: block;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .client-info span {
    font-size: 11px;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .testimonials-header {
    margin-bottom: 36px;
  }
  .testimonials-header h3 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (max-width: 1279px) {
    .client-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 1023px) {
    .client-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .client-grid { grid-template-columns: repeat(2, 1fr); }
    .testimonials-grid { grid-template-columns: 1fr; }
  }
</style>
