---
import { steps as localSteps } from '../../data/howItWorks'

interface Step { number: string; icon: string; title: string; desc: string }
interface HowItWorksData {
  tag?: string; title?: string; titleEm?: string; sub?: string; steps?: Step[]
}
interface Props { howItWorks?: HowItWorksData }

const { howItWorks } = Astro.props

const tag     = howItWorks?.tag     ?? 'How It Works'
const title   = howItWorks?.title   ?? 'FROM ORDER'
const titleEm = howItWorks?.titleEm ?? 'TO DOOR.'
const sub     = howItWorks?.sub     ?? 'Four steps. Fully automated. Completely transparent.'
const steps   = howItWorks?.steps?.length ? howItWorks.steps : localSteps
---

<section class="section section--navy how-section">
  <div class="how-inner container">

    <div class="how-header">
      <span class="tag" data-reveal>{tag}</span>
      <h2 class="section-title" data-reveal data-reveal-delay="80">
        {title}<br/><em>{titleEm}</em>
      </h2>
      <p class="section-sub" data-reveal data-reveal-delay="160">{sub}</p>
    </div>

    <div class="steps-grid">
      {steps.map((step, i) => (
        <div class="step-card" data-reveal="scale" data-reveal-delay={String(i * 100)}>
          <div class="step-number">{step.number}</div>
          <div class="step-icon">{step.icon}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
          {i < steps.length - 1 && (
            <div class="step-connector" aria-hidden="true">→</div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .how-section { padding: var(--section-y) var(--section-x); }

  .how-inner { max-width: var(--max-width); margin: 0 auto; }

  .how-header {
    text-align: center;
    margin-bottom: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .step-card {
    padding: 36px 28px;
    position: relative;
    border-right: 1px solid var(--border-subtle);
    transition: background 0.3s ease;
  }
  .step-card:last-child { border-right: none; }
  .step-card:hover { background: var(--signal-ghost); border-radius: 16px; }

  .step-number {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--signal);
    margin-bottom: 16px;
  }

  .step-icon { font-size: 32px; margin-bottom: 16px; }

  .step-title {
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .step-connector {
    position: absolute;
    top: 40px; right: -12px;
    font-size: 18px;
    color: var(--signal);
    z-index: 2;
    opacity: 0.5;
  }

  @media (max-width: 1023px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .step-card:nth-child(2) { border-right: none; }
    .step-connector { display: none; }
  }
  @media (max-width: 639px) {
    .steps-grid { grid-template-columns: 1fr; }
    .step-card { border-right: none; border-bottom: 1px solid var(--border-subtle); }
    .step-card:last-child { border-bottom: none; }
  }
</style>
