---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/shared/PageHero.astro'
import ContactForm from '../../components/react/ContactForm.tsx'
import { coverageCountries as localCoverage } from '../../data/contact'
import { useTranslations } from '../../i18n/utils'
import { client as sanity } from '../../lib/sanity'
import { siteSettingsQuery } from '../../lib/queries'

const t = useTranslations('ar')

let contactInfo = {
  email:     'hello@parcel.bh',
  phone:     '+973 1700 0000',
  phoneHref: 'tel:+97317000000',
  address:   'حي السيف، المنامة، مملكة البحرين',
  hours:     'الأحد – الخميس، 8 صباحاً – 6 مساءً',
}

let coverageCountries = localCoverage

const configured =
  import.meta.env.PUBLIC_SANITY_PROJECT_ID &&
  import.meta.env.PUBLIC_SANITY_PROJECT_ID !== 'your-project-id'

if (configured) {
  try {
    const settings = await sanity.fetch(siteSettingsQuery, { lang: 'ar' })
    if (settings?.email) {
      contactInfo = {
        email:     settings.email   ?? contactInfo.email,
        phone:     settings.phone   ?? contactInfo.phone,
        phoneHref: `tel:${(settings.phone ?? contactInfo.phone).replace(/\s/g, '')}`,
        address:   settings.address ?? contactInfo.address,
        hours:     settings.hours   ?? contactInfo.hours,
      }
    }
    if (settings?.coverageCountries?.length) coverageCountries = settings.coverageCountries
  } catch { /* use local data */ }
}

const arServiceOptions = [
  { value: 'instant',     label: 'توصيل فوري' },
  { value: 'sameday',    label: 'توصيل نفس اليوم' },
  { value: 'nextday',    label: 'توصيل اليوم التالي' },
  { value: 'ecommerce',  label: 'تلبية طلبات التجارة الإلكترونية' },
  { value: 'enterprise', label: 'حل مؤسسي / مخصص' },
]
---

<BaseLayout
  title="تواصل معنا"
  description="تواصل مع بارسل. اطلب عرض سعر، استفسر عن التكامل، أو تحدث إلى فريقنا عن احتياجات التوصيل لديك في البحرين ودول الخليج."
>
  <PageHero
    tag={t('contact.tag')}
    title={t('contact.title')}
    titleEm={t('contact.titleEm')}
    sub={t('contact.sub')}
  />

  <section class="contact-section">
    <div class="contact-inner container">

      <div class="contact-form-col">
        <ContactForm serviceOptions={arServiceOptions} lang="ar" client:visible />
      </div>

      <div class="contact-info-col">
        <h3 class="info-title">{t('contact.methods')}</h3>

        <div class="contact-methods">
          <div class="contact-method">
            <span class="method-icon">📧</span>
            <div>
              <span class="method-label">{t('footer.email')}</span>
              <a href={`mailto:${contactInfo.email}`} class="method-value method-link">{contactInfo.email}</a>
            </div>
          </div>
          <div class="contact-method">
            <span class="method-icon">📞</span>
            <div>
              <span class="method-label">{t('footer.phone')}</span>
              <a href={contactInfo.phoneHref} class="method-value method-link">{contactInfo.phone}</a>
            </div>
          </div>
          <div class="contact-method">
            <span class="method-icon">📍</span>
            <div>
              <span class="method-label">{t('footer.address')}</span>
              <span class="method-value">{contactInfo.address}</span>
            </div>
          </div>
          <div class="contact-method">
            <span class="method-icon">🕐</span>
            <div>
              <span class="method-label">{t('footer.hours')}</span>
              <span class="method-value">{contactInfo.hours}</span>
            </div>
          </div>
        </div>

        <div class="coverage-card">
          <h4>{t('contact.coverage')}</h4>
          <div class="coverage-flags">
            {coverageCountries.map(c => (
              <div class="coverage-item">
                <span>{c.flag}</span>
                <span>{c.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .contact-section { padding: var(--section-y) var(--section-x); background: var(--void); }
  .contact-inner {
    max-width: var(--max-width); margin: 0 auto;
    display: grid; grid-template-columns: 3fr 2fr; gap: 80px; align-items: start;
  }
  .info-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; text-transform: uppercase; color: var(--ink); margin-bottom: 28px; }
  .contact-methods { display: flex; flex-direction: column; gap: 20px; margin-bottom: 36px; }
  .contact-method { display: flex; align-items: flex-start; gap: 14px; }
  .method-icon { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
  .method-label { display: block; font-family: var(--font-ui); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 2px; }
  .method-value { font-family: var(--font-ui); font-size: 14px; color: var(--ink-muted); }
  .method-link  { color: var(--signal); transition: opacity 0.2s ease; }
  .method-link:hover { opacity: 0.8; }
  .coverage-card { background: var(--navy); border: 1px solid var(--border-subtle); border-radius: var(--card-radius); padding: 24px; }
  .coverage-card h4 { font-family: var(--font-display); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--signal); margin-bottom: 18px; }
  .coverage-flags { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .coverage-item { display: flex; align-items: center; gap: 6px; font-family: var(--font-ui); font-size: 13px; color: var(--ink-muted); }
  @media (max-width: 1023px) { .contact-inner { grid-template-columns: 1fr; gap: 60px; } }
</style>
